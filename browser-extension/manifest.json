{
  "manifest_version": 3,
  "name": "Clawky Browser Copilot",
  "version": "0.1.0",
  "description": "Puente seguro y controlado en tu panel lateral entre el navegador y tu asistente de IA local.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "action": {
    "default_title": "Clawky Copilot"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
